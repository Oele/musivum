+// musivum: the rules by which a controlled agent moves its selected pair (see
+// `ControlledSelector::handle_binding_request`).
+impl Agent {
+    /// pion's `controlledSelector.shouldSwitchSelectedPair` without renomination: whether a
+    /// nomination of `pair_index` moves the selected pair there. Nothing selected: yes; the
+    /// same pair: no; otherwise a lite agent follows every nomination, and a full one a pair
+    /// of higher priority (pion's `needsToCheckPriorityOnNominated`); `or_equal` also a pair
+    /// of the same priority, as pion's `HandleSuccessResponse` does for a nomination that
+    /// waited for its check.
+    fn should_switch_selected_pair(&self, pair_index: usize, or_equal: bool) -> bool {
+        match self.get_selected_pair() {
+            None => true,
+            Some(selected) if selected == pair_index => false,
+            Some(selected) => {
+                let (old, new) = (
+                    self.candidate_pairs[selected].priority(),
+                    self.candidate_pairs[pair_index].priority(),
+                );
+                self.lite || old < new || (or_equal && old == new)
+            }
+        }
+    }
 }
