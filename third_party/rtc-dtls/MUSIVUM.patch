+
+    /// musivum: a client with a short retransmission interval (LiveKit's 100 ms) whose server
+    /// answers only after two seconds still completes the handshake: the wait doubles with
+    /// every retransmission (pion's backoff). With a fixed interval its seven retransmissions
+    /// were spent after 0.8 s and the handshake failed.
+    #[cfg(feature = "crypto-ring")]
+    #[test]
+    fn a_short_retransmission_interval_backs_off_until_a_slow_server_answers() -> Result<()> {
+        let provider: Arc<dyn RTCCryptoProvider> = Arc::new(crypto::providers::RingProvider::new());
+        let suites = [CipherSuiteId::Tls_Ecdhe_Ecdsa_With_Aes_128_Gcm_Sha256];
+        let client_config = Arc::new(
+            ConfigBuilder::default()
+                .with_crypto_provider(provider.clone())
+                .with_cipher_suites(suites.to_vec())
+                .with_insecure_skip_verify(true)
+                .with_flight_interval(std::time::Duration::from_millis(100))
+                .build(true, None)?,
+        );
+        let server_config = config(provider, false, &suites)?;
+        let mut client = Endpoint::new(client_addr(), TransportProtocol::UDP, None);
+        let mut server = Endpoint::new(server_addr(), TransportProtocol::UDP, Some(server_config));
+        let start = Instant::now();
+        client.connect(start, server_addr(), client_config, None)?;
+
+        // Two seconds in which nothing the client sends arrives, and the waits it takes.
+        let mut waits = vec![];
+        let mut last = start;
+        while last.duration_since(start) < std::time::Duration::from_secs(2) {
+            while client.poll_transmit().is_some() {}
+            let deadline = client
+                .poll_timeout(&server_addr())
+                .expect("a client waiting for an answer arms a retransmit timer");
+            waits.push(deadline.duration_since(last).as_millis());
+            client.handle_timeout(server_addr(), deadline)?;
+            last = deadline;
+        }
+        assert_eq!(vec![100, 200, 400, 800, 1600], waits);
+
+        // Then the path works, and the handshake completes on both sides.
+        let (mut client_done, mut server_done) = (false, false);
+        for _ in 0..32 {
+            for event in transfer(&mut client, &mut server, client_addr())? {
+                server_done |= matches!(event, EndpointEvent::HandshakeComplete);
+            }
+            for event in transfer(&mut server, &mut client, server_addr())? {
+                client_done |= matches!(event, EndpointEvent::HandshakeComplete);
+            }
+            if client_done && server_done {
+                break;
+            }
+        }
+        assert!(client_done && server_done, "the handshake did not complete");
+        Ok(())
+    }
 }
