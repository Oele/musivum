+    /// musivum: how long to wait for an answer to the flight before it is sent again, as pion's
+    /// handshaker (`handshaker.go`): the configured interval the first time, doubled at every
+    /// retransmission, to 60 seconds at most, and the configured one again with the next flight
+    /// (`prepare` sets the count back to zero). The crate waited the configured interval every
+    /// time, so with `maximum_retransmit_number` (7) a short interval gave the handshake little
+    /// time in all: 0.8 s at LiveKit's 100 ms, too little for a client behind a relay on a mobile
+    /// network. With the doubling the seven retransmissions cover 25.5 s at 100 ms.
+    pub(crate) fn retransmit_interval(&self) -> Duration {
+        let doublings = self.current_retransmit_count.min(16) as u32;
+        self.handshake_config
+            .retransmit_interval
+            .saturating_mul(1u32 << doublings)
+            .min(Duration::from_secs(60))
+    }
