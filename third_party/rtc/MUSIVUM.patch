+/// musivum's patch: pion's `filterUnattachedRTX`, which takes the RTX codecs whose primary
+/// codec (their `apt`) is not among `codecs` away. It takes the place of `is_repair_codec`,
+/// with which the transceiver's codecs added the media engine's repair codecs (RTX, FEC, RED)
+/// to codec preferences that left them out; pion adds nothing.
+pub(crate) fn filter_unattached_rtx(
+    mut codecs: Vec<RTCRtpCodecParameters>,
+) -> Vec<RTCRtpCodecParameters> {
+    let payload_types: Vec<PayloadType> = codecs.iter().map(|c| c.payload_type).collect();
+    codecs.retain(|codec| {
+        !codec
+            .rtp_codec
+            .mime_type
+            .eq_ignore_ascii_case(MIME_TYPE_RTX)
+            || parse_rtx_apt(&codec.rtp_codec.sdp_fmtp_line)
+                .is_some_and(|apt| payload_types.contains(&apt))
+    });
+    codecs
 }
 
