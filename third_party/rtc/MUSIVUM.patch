diff -ru a/src/rtp_transceiver/rtp_receiver/internal.rs b/src/rtp_transceiver/rtp_receiver/internal.rs
--- a/src/rtp_transceiver/rtp_receiver/internal.rs
+++ b/src/rtp_transceiver/rtp_receiver/internal.rs
@@ -145,7 +145,18 @@
             let (c, match_type) =
                 codec_parameters_fuzzy_search(&codec.rtp_codec, &media_engine_codecs);
             if match_type != CodecMatch::None {
-                filtered_codecs.push(c);
+                // musivum's patch: the preferred codec, as pion's `RTPTransceiver.getCodecs`
+                // keeps it (its fmtp line, its payload type, of its feedback what the media
+                // engine has for the codec), where this crate took the media engine's.
+                let mut codec = codec.clone();
+                if codec.payload_type == 0 {
+                    codec.payload_type = c.payload_type;
+                }
+                codec
+                    .rtp_codec
+                    .rtcp_feedback
+                    .retain(|feedback| c.rtp_codec.rtcp_feedback.contains(feedback));
+                filtered_codecs.push(codec);
             }
         }
 
